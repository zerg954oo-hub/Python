def check_triangle_type():
    print("=== Определитель типа треугольника ===")
    try:
        a = float(input("Введите длину первой стороны: "))
        b = float(input("Введите длину второй стороны: "))
        c = float(input("Введите длину третьей стороны: "))
        if a <= 0 or b <= 0 or c <= 0:
            print("Ошибка: все стороны должны быть положительными числами!")
            return
        if (a + b <= c) or (a + c <= b) or (b + c <= a):
            print("Ошибка: такие стороны не могут образовать треугольник!")
            print("(Сумма любых двух сторон должна быть больше третьей)")
            return
        if a == b == c:
            print("Треугольник: РАВНОСТОРОННИЙ")
        elif a == b or a == c or b == c:
            print("Треугольник: РАВНОБЕДРЕННЫЙ")
        else:
            print("Треугольник: РАЗНОСТОРОННИЙ")
            
    except ValueError:
        print("Ошибка: пожалуйста, введите числовые значения!")

def detailed_triangle_check():
    print("=== Определитель типа треугольника ===")
    
    try:
        a = float(input("Введите длину первой стороны: "))
        b = float(input("Введите длину второй стороны: "))
        c = float(input("Введите длину третьей стороны: "))
        if a <= 0 or b <= 0 or c <= 0:
            print("❌ Ошибка: все стороны должны быть положительными числами!")
            return
        sides_valid = True
        if a + b <= c:
            print(f"❌ Стороны {a} + {b} = {a+b} ≤ {c} - нарушение неравенства треугольника")
            sides_valid = False
        if a + c <= b:
            print(f"❌ Стороны {a} + {c} = {a+c} ≤ {b} - нарушение неравенства треугольника")
            sides_valid = False
        if b + c <= a:
            print(f"❌ Стороны {b} + {c} = {b+c} ≤ {a} - нарушение неравенства треугольника")
            sides_valid = False
        if not sides_valid:
            print("Такие стороны не могут образовать треугольник!")
            return
        print(f"\nСтороны треугольника: {a}, {b}, {c}")
        if a == b == c:
            print("✅ Треугольник: РАВНОСТОРОННИЙ")
            print("   (Все три стороны равны)")
        elif a == b:
            print("✅ Треугольник: РАВНОБЕДРЕННЫЙ")
            print(f"   (Стороны a={a} и b={b} равны, основание c={c})")
        elif a == c:
            print("✅ Треугольник: РАВНОБЕДРЕННЫЙ")
            print(f"   (Стороны a={a} и c={c} равны, основание b={b})")
        elif b == c:
            print("✅ Треугольник: РАВНОБЕДРЕННЫЙ")
            print(f"   (Стороны b={b} и c={c} равны, основание a={a})")
        else:
            print("✅ Треугольник: РАЗНОСТОРОННИЙ")
            print("   (Все стороны имеют разную длину)")
    except ValueError:
        print("❌ Ошибка: пожалуйста, введите числовые значения!")
