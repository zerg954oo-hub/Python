def calculate_figure():
    print("=== Определитель фигуры и площади ===")
    
    try:
        side1 = float(input("Введите длину первой стороны: "))
        side2 = float(input("Введите длину второй стороны: "))
        if side1 <= 0 or side2 <= 0:
            print("❌ Ошибка: стороны должны быть положительными числами!")
            return
        if side1 == side2:
            figure_type = "КВАДРАТ"
        else:
            figure_type = "ПРЯМОУГОЛЬНИК"
        area = side1 * side2
        print(f"\n📐 Фигура: {figure_type}")
        print(f"📏 Сторона A: {side1}")
        print(f"📏 Сторона B: {side2}")
        print(f"📊 Площадь: {area}")
        
    except ValueError:
        print("❌ Ошибка: пожалуйста, введите числовые значения!")
